# Environment Variables for Sigil
#
# Copy to `.env` for local development. Real IDs and keys must not be committed;
# `.env` is gitignored. Release builds can inject these at compile time (e.g. CI secrets).
#
# Two kinds of value (scripts/release/env-classification.json):
#   - PUBLIC (client ids, *_REDIRECT_LOCAL): embedded in the web bundle, which Sigil's own web server serves.
#   - SECRET (*_CLIENT_SECRET, *_API_KEY): read by src-tauri/build.rs and compiled into Sigil.exe only
#     (lightly obfuscated, which is NOT protection), never into the web bundle. Kick has no public-client
#     flow, so its secret has to ship inside the app; rotate it in the Kick developer portal if it is abused.
#     After creating `.env` for the first time, touch src-tauri/build.rs (or run cargo clean -p sigil) so
#     Cargo notices it. `node scripts/release/check-no-secrets.mjs dist` checks a build for leaks.

# Twitch OAuth (https://dev.twitch.tv/console/apps)
#
# Register ALL redirect URLs your flows use:
#   - Desktop loopback (always): http://localhost:17890/oauth/twitch/implicit and …/callback
#   - Vite dev (pnpm dev): http://localhost:1420/oauth/twitch/implicit and …/callback
#   - Packaged Tauri app: https origin of the main window (not :1420). Run window.location.origin
#     in the built app’s devtools, or set the SIGIL_*_REDIRECT_LOCAL vars below before `pnpm build`.
#
# Confidential apps: set the client secret below (Rust side only).
SIGIL_TWITCH_CLIENT_ID=your_twitch_client_id_here
# Legacy (still works): CURSES_TWITCH_CLIENT_ID=…
# SIGIL_TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
# SIGIL_TWITCH_CLIENT_REDIRECT_LOCAL=https://your-packaged-origin/oauth/twitch/callback
# SIGIL_TWITCH_IMPLICIT_REDIRECT_LOCAL=https://your-packaged-origin/oauth/twitch/implicit

# Kick (https://kick.com/settings/developer)
# Register http://localhost:17890/oauth/kick/callback (desktop app; http://localhost:1420/oauth/kick/callback is the
# only other redirect Sigil accepts). Kick sign-in needs the desktop app, not a browser tab: the token exchange
# runs in Rust with the client secret below.
SIGIL_KICK_CLIENT_ID=your_kick_client_id_here
# Legacy (still works): CURSES_KICK_CLIENT_ID=…
SIGIL_KICK_CLIENT_SECRET=your_kick_client_secret_here
# Legacy (still works): CURSES_KICK_CLIENT_SECRET=…

# Optional: Google Fonts API (for custom font loading). Fetched by the Rust side; restrict the key to the
# Fonts API in the Google Cloud console.
SIGIL_GOOGLE_FONTS_API_KEY=your_google_fonts_api_key_here
# Legacy (still works): VITE_GOOGLE_FONTS_API_KEY=…
