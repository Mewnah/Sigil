{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigil.local/schemas/sigil-listening-mt-1.json",
  "title": "sigil-listening-mt/1",
  "description": "The manifest of a blind MT A/B test (make_mt_test.py writes it into test/manifest.json and test/manifest.js; mt-ab.html reads it). It never names the systems: the A / B sides map to systems only in key.json, which stays with the organizer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "test_id", "title", "trials"],
  "properties": {
    "schema": { "const": "sigil-listening-mt/1" },
    "test_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "title": { "type": "string" },
    "instructions": { "type": "string" },
    "question": { "type": "string" },
    "show_reference": { "type": "boolean", "default": false },
    "allow_both_bad": { "type": "boolean", "default": true },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "direction", "source", "a", "b"],
        "properties": {
          "id": { "type": "string", "pattern": "^t[0-9]{3,5}$" },
          "direction": { "type": "string" },
          "source": { "type": "string" },
          "context": { "type": ["string", "null"], "description": "The previous source line of the same document, shown dimmed." },
          "reference": { "type": ["string", "null"] },
          "a": { "type": "string" },
          "b": { "type": "string" }
        }
      }
    }
  }
}
