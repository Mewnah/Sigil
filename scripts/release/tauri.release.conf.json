{
  "build": {
    "beforeBuildCommand": "pnpm build && node scripts/release/stage-native-dlls.mjs --prepare",
    "beforeBundleCommand": "node scripts/release/stage-native-dlls.mjs --stage"
  },
  "bundle": {
    "resources": {
      "target/native-bundle": "."
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
