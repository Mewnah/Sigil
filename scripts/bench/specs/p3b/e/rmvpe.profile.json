      "requires": [
        "SLOT",
        "CLIP"
      ],
      "vars": {
        "EP": "dml"
      }
    },
    {
      "file": "specs/p3b/e/rmvpe-gpu.template.json",
      "name": "rmvpe-cuda-levers",
      "requires": [
        "SLOT",
        "CLIP"
      ],
      "vars": {
        "EP": "cuda",
        "LEVERS_JSON": "{\"io_binding\": \"on\", \"cuda_graphs\": \"on\", \"gpu_priority\": \"on\"}"
      }
    },
    {
      "file": "specs/p3b/e/rmvpe-offline.template.json",
