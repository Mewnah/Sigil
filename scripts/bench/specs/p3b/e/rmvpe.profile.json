{
  "$comment": "P3B-E's own A/B profile (not a scorecard profile: the scorecard is scripts/bench/profiles/p3b.json, P3B-A's). Paths are relative to scripts/bench. Use with -CompareExe <same exe> -CompareEnv '<SIGIL_RMVPE_* switch>' (side B gets the switch). BUILD=direct: the engine without the voice factory, so the attribution splits onset ticks from steady ones (f0_ms_steady_*, call_ms_onset_*).",
  "schema": "sigil-bench-profile/1",
  "name": "p3b-e-rmvpe",
  "description": "RMVPE plan size (the VRAM saver), t32 and fp16 A/B on DirectML and CUDA (P3B-E verification 3).",
  "specs": [],
  "vars": {
    "CLIP": "",
    "SLOT": "",
    "CONTENT_ENCODER": "",
    "BUILD": "direct",
    "BLOCK_FRAMES": "512",
    "EXTRA_MS": "64",
    "PITCH": "rmvpe",
    "LEVERS_JSON": "{}",
    "QOS": "app",
    "OFFLINE_REPEAT_JSON": "8",
    "PACED_S_JSON": "30"
  },
  "templates": [
