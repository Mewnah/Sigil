{
  "$comment": [
    "CPU speed of the CPU-tier finals and translators with a game on the same CPU (plan section 8: Qwen3-ASR-0.6B, Hy-MT2 1.8B and Bergamot CJK on a 6-8 core CPU while VRChat runs).",
    "The h3_cpu_game profile is 4 burner threads at 60 %; a friend with VRChat running sets load_profile none and describes it in external_load.",
    "Timing runs hold the GPU timing lock on the dev rig: pwsh scripts/bench/gpu-lock.ps1 -Run P7-A -Wait 60 -Command \"<Sigil.exe> --headless speech-bench ...\"."
  ],
  "schema": "sigil-speech-bench-spec/1",
  "name": "cpu-speed",
  "seed": 20261002,
  "corpus": {
    "manifest": "${SIGIL_P7_CORPUS}/corpus.json",
    "select": { "subset": "quick", "kinds": ["synthetic"], "limit_per_language": 20 }
  },
  "engines": [
    { "id": "qwen3-asr-0.6b-t2", "task": "stt", "backend": "sherpa-offline", "model": "stt/qwen3-asr-0.6b-int8", "execution_provider": "cpu", "threads": 2, "languages": ["ja", "ko", "zh", "ru"] },
    { "id": "qwen3-asr-0.6b-t4", "task": "stt", "backend": "sherpa-offline", "model": "stt/qwen3-asr-0.6b-int8", "execution_provider": "cpu", "threads": 4, "languages": ["ja", "ko", "zh", "ru"] },
    { "id": "nemotron-560", "task": "stt", "backend": "sherpa-online", "model": "stt/nemotron-3.5-streaming-560ms-int8", "execution_provider": "cpu", "threads": 1, "languages": ["en", "ja"] },
    { "id": "hy-mt2-1.8b-cpu", "task": "mt", "backend": "llama-server", "model": "mt/hy-mt2-1.8b-q4_k_m", "execution_provider": "cpu", "threads": 4, "options": { "prompt": "hy-mt2", "maxTokens": 256, "temperature": 0.2 } },
    { "id": "bergamot", "task": "mt", "backend": "bergamot", "execution_provider": "cpu", "threads": 1, "directions": ["en-ja", "ja-en", "en-zh", "zh-en", "en-ko", "ko-en"] },
    { "id": "kokoro-cpu", "task": "tts", "backend": "local-tts", "model": "tts/kokoro-v1.0", "execution_provider": "cpu", "threads": 4, "languages": ["en", "ja"], "options": { "voices": { "en": "af_heart", "ja": "jf_alpha" } } }
  ],
  "runs": [
    {
      "name": "stt-idle",
      "mode": "cpu_speed",
      "engines": ["qwen3-asr-0.6b-t2", "qwen3-asr-0.6b-t4", "nemotron-560"],
      "feed": { "kind": "utterance" },
      "warmup": 2,
      "repeat": 3,
      "load_profile": "none",
      "gpu_lock": { "require": true, "tag": "P7-A" }
    },
    {
      "name": "stt-game",
      "mode": "cpu_speed",
      "engines": ["qwen3-asr-0.6b-t2", "qwen3-asr-0.6b-t4", "nemotron-560"],
      "feed": { "kind": "utterance" },
      "warmup": 2,
      "repeat": 3,
      "load_profile": "h3_cpu_game",
      "gpu_lock": { "require": true, "tag": "P7-A" },
      "thresholds": { "rtf_p95": { "max": 0.5 } }
    },
    {
      "name": "stt-finals-latency",
      "mode": "cpu_speed",
      "engines": ["nemotron-560"],
      "select": { "subset": "quick", "kinds": ["synthetic"], "languages": ["en"], "limit_per_language": 10 },
      "feed": { "kind": "stream", "chunk_ms": 100, "pace": "realtime", "tail_silence_ms": 1000 },
      "load_profile": "h3_cpu_game",
      "gpu_lock": { "require": true, "tag": "P7-A" }
    },
    {
      "name": "mt-game",
      "mode": "cpu_speed",
      "engines": ["hy-mt2-1.8b-cpu", "bergamot"],
      "mt": { "set": "${SIGIL_P7_CORPUS}/mt/sigil-casual.jsonl", "directions": ["en-ja", "ja-en", "en-zh", "zh-en", "en-ko", "ko-en"], "limit": 24 },
      "warmup": 2,
      "load_profile": "h3_cpu_game",
      "gpu_lock": { "require": true, "tag": "P7-A" },
      "thresholds": { "latency_ms_p95": { "max": 1500 } }
    },
    {
      "name": "tts-game",
      "mode": "cpu_speed",
      "engines": ["kokoro-cpu"],
      "tts": { "prompts": "${SIGIL_P7_CORPUS}/tts/prompts.jsonl", "limit_per_language": 8, "write_audio": false },
      "load_profile": "h3_cpu_game",
      "gpu_lock": { "require": true, "tag": "P7-A" }
    }
  ],
  "output": { "write_hypotheses": true, "export": { "include_text": false, "include_items": true } }
}
