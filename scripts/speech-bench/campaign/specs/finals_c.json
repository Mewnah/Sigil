{
 "$comment": [
  "core subset, 30 utterances per language: SenseVoice, Granite (en), Nemotron (en)"
 ],
 "schema": "sigil-speech-bench-spec/1",
 "name": "p7a-finals-c",
 "description": "core subset, 30 utterances per language: SenseVoice, Granite (en), Nemotron (en)",
 "seed": 20261002,
 "corpus": {
  "manifest": "${SIGIL_P7_CORPUS}/corpus.json",
  "select": {
   "subset": "core",
   "kinds": [
    "synthetic"
   ],
   "limit_per_language": 30
  }
 },
 "engines": [
  {
   "id": "sensevoice",
   "task": "stt",
   "backend": "sherpa-offline",
   "model": "stt/sense-voice-small-int8",
   "execution_provider": "cpu",
   "threads": 2,
   "languages": [
    "zh",
    "ja",
    "ko",
    "en"
   ]
  },
  {
   "id": "granite-cpu",
   "task": "stt",
   "backend": "transcribe",
   "model": "stt/granite-speech-5.0-turboctc-q8_0",
   "execution_provider": "cpu",
   "threads": 4,
   "languages": [
    "en"
   ]
  },
  {
   "id": "nemotron-560",
   "task": "stt",
   "backend": "sherpa-online",
   "model": "stt/nemotron-3.5-streaming-560ms-int8",
   "execution_provider": "cpu",
   "threads": 1,
   "languages": [
    "en"
   ]
  }
 ],
 "runs": [
  {
   "name": "finals",
   "mode": "accuracy",
   "feed": {
    "kind": "utterance"
   },
   "warmup": 1,
   "timeout_s": 180
  }
 ],
 "output": {
  "write_hypotheses": true,
  "export": {
   "include_text": true,
   "include_items": true
  }
 }
}