     "zh"
    ],
    "limit_per_language": 3
   },
   "feed": {
    "kind": "pipeline",
    "pace": "realtime",
    "lead_silence_ms": 500,
    "tail_silence_ms": 1500
   },
   "warmup": 0,
   "repeat": 1,
   "load_profile": "h3_cpu_game",
   "gpu_lock": {
    "require": true,
    "tag": "P7-A"
   },
   "timeout_s": 240
  }
 ]
