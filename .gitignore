# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dev-dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.yarn
/test-results/
/playwright-report/
/playwright/.cache/
# Cursor / local agent state (not part of the app)
.agent/
.cursor/*.log

# npm lockfile — this repo standardizes on pnpm (see pnpm-lock.yaml)
package-lock.json

# Secrets and local overrides — never commit real credentials
.env
.env.*
!.env.example

# Local audit / scratch output (keep repo clean for release)
audit_tsc.txt
tsc_*.txt
src-tauri/audit_*.txt
src-tauri/cargo_*.txt
gemini_models.txt
find_free_models.py
ws_test.js

# Vite rollup visualizer (regenerated locally)
stats/

# Tauri `icon` CLI also emits iOS/Android sets; desktop bundle uses paths in tauri.conf.json only
src-tauri/icons/ios/
src-tauri/icons/android/

# Benchmark harness output (`Sigil.exe --headless bench ... --out bench-results/...`); curated
# scorecards go to docs/benchmarks/ instead.
bench-results/

# Native runtime-pack builds (P1: CMake build trees and packaged packs under native/); packs are
# installed locally through the model store / SIGIL_LOCAL_ASSETS, never committed.
native/build/
native/out/
native/dist/
# sherpa-onnx bindgen helper (gen-bindings.ps1 builds outside the repo; this guards a manual `cargo run`).
scripts/runtime-packs/sherpa/bindgen/target/
# Python tooling caches (scripts/vc-templates, scripts/bench).
__pycache__/
